<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- حاوية البطاقة الزجاجية -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_container"
        android:layout_width="168dp"
        android:layout_height="102dp"
        app:cardBackgroundColor="@color/apple_tile_bg"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:cardMaxElevation="32dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- صورة أيقونة التطبيق الأصلية عالية الدقة -->
            <ImageView
                android:id="@+id/iv_app_icon"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_gravity="center"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                tools:src="@mipmap/ic_launcher" />

            <!-- لمعان زجاجي علوي متحرك يحاكي زجاج Apple TV -->
            <View
                android:id="@+id/view_specular_highlight"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0"
                android:background="@drawable/glass_specular_overlay" />

            <!-- شارة التطبيق المفضل -->
            <ImageView
                android:id="@+id/iv_favorite_badge"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="top|end"
                android:layout_margin="8dp"
                android:src="@drawable/ic_star_filled"
                android:visibility="gone" />

            <!-- إطار تحديد التركيز الأبيض المضيء -->
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/selector_app_focus" />

        </FrameLayout>
    </androidx.cardview.widget.CardView>

    <!-- اسم التطبيق بأسلوب Apple TV الأنيق -->
    <TextView
        android:id="@+id/tv_app_title"
        android:layout_width="168dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:fontFamily="sans-serif-medium"
        tools:text="YouTube" />

</LinearLayout>
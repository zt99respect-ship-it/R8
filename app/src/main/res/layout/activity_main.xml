<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/apple_dark_bg">

    <!-- خلفية التوهج المحيطي الديناميكي (Ambient Backlight) -->
    <View
        android:id="@+id/view_ambient_glow"
        android:layout_width="match_parent"
        android:layout_height="480dp"
        android:alpha="0.35"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- خلفية الرف السينمائي الشفافة (Top Shelf Backdrop) -->
    <ImageView
        android:id="@+id/iv_top_shelf_backdrop"
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:scaleType="centerCrop"
        android:src="@drawable/apple_tv_aerial_gradient"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:background="@drawable/scrim_gradient_shelf"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- الشريط العلوي (Status Bar): الساعة، التاريخ، وشعارات Apple TV -->
    <LinearLayout
        android:id="@+id/layout_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="48dp"
        android:paddingTop="28dp"
        android:paddingEnd="48dp"
        app:layout_constraintTop_toTopOf="parent">

        <!-- شعار Apple TV الفاخر والمعلومات -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_focused_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="32sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                tools:text="Apple TV 4K Launcher" />

            <TextView
                android:id="@+id/tv_focused_package"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/apple_text_secondary"
                android:textSize="14sp"
                tools:text="com.appletv.launcher" />
        </LinearLayout>

        <!-- الساعة والتاريخ بتصميم tvOS الحديث -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="26sp"
                android:textStyle="bold"
                tools:text="10:45 PM" />

            <TextView
                android:id="@+id/tv_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/apple_text_secondary"
                android:textSize="14sp"
                tools:text="الجمعة، 30 أكتوبر" />
        </LinearLayout>
    </LinearLayout>

    <!-- شبكة التطبيقات (Apps Grid) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_apps"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingStart="40dp"
        android:paddingTop="24dp"
        android:paddingEnd="40dp"
        android:paddingBottom="48dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_top_bar" />

</androidx.constraintlayout.widget.ConstraintLayout>
<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.appletv.launcher">

    <!-- تصريح عدم الحاجة لشاشة لمس لدعم أجهزة التلفزيون وTV Box وعصا البث -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <!-- دعم واجهة Android TV Leanback -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="true" />

    <!-- أذونات فحص التطبيقات المثبتة واستخراج أيقوناتها على Android 11+ (API 30+) -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission android:name="android.permission.REORDER_TASKS" />

    <!-- استلام أحداث تثبيت وحذف التطبيقات لتحديث القائمة تلقائياً -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:banner="@drawable/banner_apple_tv"
        android:label="@string/app_name"
        android:theme="@style/Theme.AppleTvLauncher"
        android:hardwareAccelerated="true"
        android:largeHeap="true"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:banner="@drawable/banner_apple_tv"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:clearTaskOnLaunch="false"
            android:stateNotNeeded="true"
            android:screenOrientation="landscape"
            android:windowSoftInputMode="stateAlwaysHidden">

            <!-- تسجيل النشاط كلانشر نظام افتراضي عند الضغط على زر HOME بالريموت -->
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <!-- دعم لانشر شاشات التلفزيون Leanback -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- مستقبل أحداث النظام لتحديث شبكة التطبيقات فور تثبيت أو إزالة أي تطبيق -->
        <receiver
            android:name=".receiver.PackageChangesReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.PACKAGE_ADDED" />
                <action android:name="android.intent.action.PACKAGE_REMOVED" />
                <action android:name="android.intent.action.PACKAGE_REPLACED" />
                <data android:scheme="package" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
